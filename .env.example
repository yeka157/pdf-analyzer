# ---------------------------------------------------------------------------
# Database — Supabase (Supavisor) + Prisma 7
# ---------------------------------------------------------------------------
# Prisma 7 moved connection URLs out of schema.prisma into prisma.config.ts,
# and no longer auto-loads .env (prisma.config.ts imports "dotenv/config").
#
# Supabase recommends a dedicated `prisma` DB role rather than `postgres`.
# Note the dotted Supavisor tenant format: <role>.<project-ref>
#
# Transaction mode (port 6543) — used by the app at runtime via the pg driver
# adapter in lib/prisma.ts. `pgbouncer=true` is REQUIRED: transaction mode has
# no prepared-statement support and Prisma errors without it.
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session mode (port 5432) — used by the Prisma CLI via prisma.config.ts for
# generate / migrate / db push. Must be set even for `prisma generate`, or the
# CLI fails to load its config.
DIRECT_URL="postgres://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Clerk auth — proxy.ts, app/(auth)/*, @clerk/nextjs
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk webhook (Svix) signing secret — app/api/webhooks/clerk/route.ts
WEBHOOK_SECRET="whsec_..."

# Optional: only needed if the sign-in/sign-up routes move off Clerk's defaults
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ---------------------------------------------------------------------------
# Stripe — lib/stripe.ts, app/pricing/page.tsx, app/api/webhooks/stripe/route.ts
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
# Price ID of the subscription plan sold on /pricing
STRIPE_PRICE_ID="price_..."
# Signing secret from `stripe listen` (local) or the Stripe dashboard endpoint (prod)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Google Gemini — app/api/analyze/route.ts
# ---------------------------------------------------------------------------
GEMINI_API_KEY="AIza..."

# ---------------------------------------------------------------------------
# App URLs — app/pricing/page.tsx (Stripe checkout / portal return URLs)
# ---------------------------------------------------------------------------
# Overrides everything below when set; leave blank locally to fall back to
# http://localhost:3000
NEXT_PUBLIC_URL=""
# Used when NODE_ENV === "production" and NEXT_PUBLIC_URL is unset
PRODUCTION_URL="https://your-domain.com"

# ---------------------------------------------------------------------------
# Vercel Cron — app/api/cron/supabase-keepalive/route.ts
# ---------------------------------------------------------------------------
# Random secret of at least 16 characters. Vercel sends it as a Bearer token
# when invoking the daily Supabase keepalive route.
CRON_SECRET="replace-with-a-random-secret"
